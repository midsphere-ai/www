---
// "You built it before lunch."
// Three-step build-day timeline: sketch → wire up → ship. Each card carries
// its own action doodle (napkin / plug / paper plane). A small mono flourish
// below the closing line bookends the section the way Hero's check + caption
// closes the top of the page.
import DayDoodle from '../ui/DayDoodle.astro';

type DayStepKind = 'sketch' | 'wire' | 'launch';
type DayStep = { n: string; kind: DayStepKind; text: string };

const dayInLifeSteps: DayStep[] = [
  { n: '09:14', kind: 'sketch', text: 'Sketch it on the back of something.' },
  { n: '11:02', kind: 'wire',   text: 'Wire it up. Hand it the goal.' },
  { n: '14:20', kind: 'launch', text: 'Ship to production.' },
];
---

<section id="today" class="section">
  <div class="container-x">
    <div class="mb-10 text-center">
      <div class="eyebrow">today</div>
      <h2 id="today-headline" class="h-section mx-auto mt-3 max-w-[860px]">
        You built it before lunch. <span class="hl">Your competitors are still in their planning meeting.</span>
      </h2>
    </div>

    <ol class="mx-auto grid max-w-[900px] grid-cols-1 gap-4 md:grid-cols-3 md:gap-5">
      {dayInLifeSteps.map((step) => (
        <li class="card p-6">
          <div class="mb-4">
            <DayDoodle kind={step.kind} />
          </div>
          <div class="font-mono text-[12px]" style="color: var(--ms-fg-3); letter-spacing: 0.06em;">{step.n}</div>
          <p class="mt-2 font-medium text-fg-1" style="font-size: 16px; line-height: 1.4;">{step.text}</p>
        </li>
      ))}
    </ol>

    <div class="mx-auto mt-12 max-w-[640px] text-center">
      <p class="text-fg-2" style="font-size: 17px; line-height: 1.6;">
        You don't read a single paper or pick a model. You don't build the thing the agent runs on. <span class="hl-soft">That's our problem.</span>
      </p>

      <!-- Closing flourish: small check + mono caption. Bookends the section
           the way Hero's "free credits · no card · no setup file" closes the
           top of the page. Three concrete things you didn't have to set up. -->
      <div class="mt-6 flex items-center justify-center gap-2" style="opacity: 0.7;">
        <svg width="18" height="14" viewBox="0 0 20 16" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 9 L 8 14 L 18 2"/>
        </svg>
        <span class="font-mono" style="font-size: 11px; letter-spacing: 0.06em; color: var(--ms-fg-2);">
          no eval harness · no inference cluster · no on-call
        </span>
      </div>
    </div>
  </div>
</section>
