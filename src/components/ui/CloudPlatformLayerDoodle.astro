---
// Doodles for the "what we ship around the agent" cards on
// /compare/cloud-providers. One per platform-layer piece. Sized to slot into
// StopDoingCard's 88px doodle row.
type Kind = 'controls' | 'schedule' | 'analytics' | 'definitions' | 'components';

interface Props {
  kind: Kind;
  width?: number;
  height?: number;
}

const { kind, width = 124, height = 80 } = Astro.props;
---

<svg
  viewBox="0 0 130 84"
  width={width}
  height={height}
  fill="none"
  stroke="#111"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {kind === 'controls' && (
    <>
      <path d="M10 14 L 10 26" stroke-width="1.2"/>
      <path d="M120 16 L 120 26" stroke-width="1.2"/>
      <path d="M10 20 C 40 22, 80 18, 120 21" stroke-width="1.2"/>
      <circle cx="56" cy="20" r="4.5" fill="#fff"/>

      <path d="M10 36 L 10 48" stroke-width="1.2"/>
      <path d="M120 38 L 120 48" stroke-width="1.2"/>
      <path d="M10 42 C 38 40, 82 44, 120 41" stroke-width="1.2"/>
      <circle cx="92" cy="42" r="4.5" fill="#fff"/>

      <path d="M10 58 L 10 70" stroke-width="1.2"/>
      <path d="M120 60 L 120 70" stroke-width="1.2"/>
      <path d="M10 64 C 42 66, 80 62, 120 65" stroke-width="1.2"/>
      <circle cx="36" cy="64" r="4.5" fill="#fff"/>
    </>
  )}

  {kind === 'schedule' && (
    <>
      <path d="M30 6 L 30 14" stroke-width="1.2"/>
      <path d="M100 6 L 100 14" stroke-width="1.2"/>
      <rect x="18" y="14" width="94" height="58" rx="3"/>
      <path d="M18 26 L 112 26" stroke-width="1.2"/>
      <circle cx="32" cy="40" r="1.4" fill="#111"/>
      <circle cx="52" cy="40" r="1.4" fill="#111"/>
      <circle cx="72" cy="40" r="1.4" fill="#111"/>
      <circle cx="92" cy="40" r="1.4" fill="#111"/>
      <circle cx="32" cy="54" r="1.4" fill="#111"/>
      <circle cx="52" cy="54" r="6.5" stroke-width="1.4"/>
      <circle cx="72" cy="54" r="1.4" fill="#111"/>
      <circle cx="92" cy="54" r="1.4" fill="#111"/>
      <circle cx="32" cy="66" r="1.4" fill="#111"/>
      <circle cx="52" cy="66" r="1.4" fill="#111"/>
      <circle cx="72" cy="66" r="1.4" fill="#111"/>
      <circle cx="92" cy="66" r="1.4" fill="#111"/>
    </>
  )}

  {kind === 'analytics' && (
    <>
      <path d="M14 72 L 90 72" stroke-width="1.2"/>
      <rect x="20" y="56" width="11" height="16"/>
      <rect x="36" y="42" width="11" height="30"/>
      <rect x="52" y="50" width="11" height="22"/>
      <rect x="68" y="34" width="11" height="38"/>
      <circle cx="98" cy="28" r="14"/>
      <path d="M88 32 L 94 26 L 100 22" stroke-width="1.2"/>
      <path d="M108 38 L 122 54" stroke-width="2"/>
    </>
  )}

  {kind === 'definitions' && (
    <>
      <path d="M14 24 L 88 18 L 92 64 L 18 70 Z" style="opacity: 0.55;"/>
      <path d="M20 18 L 96 14 L 100 60 L 24 64 Z" style="opacity: 0.8;"/>
      <path d="M26 12 L 102 10 L 106 56 L 30 58 Z"/>
      <path d="M34 22 L 96 22" stroke-width="1.2"/>
      <path d="M34 32 L 90 32" stroke-width="1.2"/>
      <path d="M34 42 L 84 42" stroke-width="1.2"/>
      <path d="M104 50 L 118 64 L 114 70 L 100 56 Z"/>
      <path d="M118 64 L 114 70" stroke-width="1.2"/>
      <path d="M101 57 L 105 53" stroke-width="1.2"/>
    </>
  )}

  {kind === 'components' && (
    <>
      <rect x="10" y="10" width="110" height="64" rx="3"/>
      <path d="M10 22 L 120 22" stroke-width="1.2"/>
      <circle cx="18" cy="16" r="1.4" fill="#111"/>
      <circle cx="24" cy="16" r="1.4" fill="#111"/>
      <circle cx="30" cy="16" r="1.4" fill="#111"/>
      <rect x="18" y="30" width="26" height="10" rx="2"/>
      <rect x="50" y="28" width="62" height="14" rx="2"/>
      <rect x="18" y="48" width="40" height="20" rx="2"/>
      <path d="M64 52 L 112 52" stroke-width="1.2"/>
      <path d="M64 60 L 106 60" stroke-width="1.2"/>
      <path d="M64 68 L 112 68" stroke-width="1.2"/>
    </>
  )}
</svg>
