---
type DoodleKind = 'sketch' | 'wire' | 'launch';

interface Props {
  kind: DoodleKind;
  class?: string;
}

const { kind, class: className } = Astro.props;

const dimensions: Record<DoodleKind, { vb: string; w: number; h: number }> = {
  sketch: { vb: '0 0 84 60', w: 78, h: 56 },
  wire:   { vb: '0 0 84 60', w: 78, h: 56 },
  launch: { vb: '0 0 84 60', w: 78, h: 56 },
};

const dim = dimensions[kind];
---

<svg
  viewBox={dim.vb}
  width={dim.w}
  height={dim.h}
  fill="none"
  stroke="#111"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {kind === 'sketch' && (
    <>
      <path d="M10 14 L 60 8 L 72 22 L 74 52 L 14 56 Z"/>
      <path d="M60 8 L 60 22 L 72 22"/>
      <path d="M22 30 C 30 26, 40 28, 52 30"/>
      <path d="M22 38 L 50 38"/>
      <path d="M54 38 L 64 38" stroke-dasharray="2 2"/>
      <path d="M22 46 L 36 46"/>
    </>
  )}
  {kind === 'wire' && (
    <>
      <rect x="50" y="22" width="22" height="22" rx="2"/>
      <path d="M58 28 L 58 38 M 64 28 L 64 38"/>
      <path d="M14 32 C 22 32, 28 48, 38 38 C 44 32, 46 33, 50 33"/>
      <rect x="6" y="28" width="8" height="10" rx="1"/>
      <path d="M2 30 L 6 30 M 2 36 L 6 36"/>
    </>
  )}
  {kind === 'launch' && (
    <>
      <path d="M6 52 C 18 46, 28 36, 40 22" stroke-dasharray="2 3"/>
      <path d="M40 16 L 76 22 L 56 30 Z"/>
      <path d="M56 30 L 60 44"/>
      <path d="M40 16 L 56 30"/>
    </>
  )}
</svg>
