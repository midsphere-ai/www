---
// "What the agent can do for your users."
// Elaborates on BringYourOwn's "we brought the agent" half. Reader is the
// developer; subject is the agent's user-facing surface, not internals.
// Page chapters: hero + native + extended (what it brings) → modes + outputs
// (how it shows up) → use cases + closing (what you'd build).
import PageLayout from '../layouts/PageLayout.astro';
import ClosingPanel from '../components/ui/ClosingPanel.astro';

type Native = { num: string; title: string; body: string };
const native: Native[] = [
  { num: '01', title: 'Browse the web.',                     body: "Reads live pages and pulls together what's relevant. Cites where it found things." },
  { num: '02', title: 'Read documents.',                     body: 'PDFs, Word, plain text, whatever your users upload. The agent uses what is inside.' },
  { num: '03', title: 'Run code.',                           body: 'Writes code, runs it in isolation, uses the output for the next step.' },
  { num: '04', title: 'Generate files.',                     body: 'Markdown, code, structured data. Files your users can download or hand to the next system.' },
  { num: '05', title: 'Search what you have handed it.',     body: "Looks up answers in the docs, data, and notes you've connected." },
  { num: '06', title: 'Plan multi-step work.',               body: 'Breaks the task into steps and runs them in order, with a record of how it got there.' },
  { num: '07', title: 'Pick up after errors.',               body: 'When a step fails partway through, the agent adjusts and keeps going.' },
  { num: '08', title: 'Stay on task for hours.',             body: "Long-running work doesn't lose the thread. The agent keeps the trail of what it has done." },
  { num: '09', title: 'Return whatever shape you ask for.',  body: 'JSON, Markdown, table rows, any schema you specify. Always parseable.' },
];

type UseCase = { id: string; eyebrow: string; title: string; body: string };
const useCases: UseCase[] = [
  { id: 'research-assistant', eyebrow: 'research assistant', title: 'Users ask. Agent answers with sources.', body: 'Browses the open web and the docs you trust. Returns a write-up the user can read in five minutes.' },
  { id: 'support',            eyebrow: 'support agent',      title: 'Reads tickets. Drafts replies. Waits.',  body: "Pulls from your runbook and your logs. The draft sits in a human's queue. Nothing goes out without sign-off." },
  { id: 'extraction',         eyebrow: 'extraction pipeline',title: 'Files in. Clean rows out.',              body: 'Users upload invoices, contracts, statements. The agent pulls structured data, validates against a schema, returns clean rows.' },
  { id: 'monitor',            eyebrow: 'monitoring agent',   title: 'Runs on a schedule. Alerts you.',        body: 'Checks the data sources you care about. Pages someone when something crosses a line.' },
  { id: 'workflow',           eyebrow: 'workflow automation',title: 'Stitches services together.',            body: "Multi-step tasks across whatever your user has connected. Calendar, inbox, CRM, payments. The agent threads them." },
  { id: 'content',            eyebrow: 'content production', title: "Generates from the user's data.",         body: 'Posts, summaries, reports. Drawn from what the user already has, in the format your product is known for.' },
];
---

<PageLayout
  title="What the agent can do · Midsphere"
  description="Every Midsphere agent ships capable: web browsing, document reading, code execution, file generation, multi-step planning. Add tools to extend it. Run on demand, on a schedule, or on a webhook."
  breadcrumbs={[
    { name: 'Home', url: 'https://midsphere.ai' },
    { name: 'The agent', url: 'https://midsphere.ai/agent' },
  ]}
>
  <!-- HERO -->
  <section id="agent-hero" class="section-tight pt-12 text-center lg:pt-16">
    <div class="container-x">
      <!-- Open satchel: the agent shows up loaded out. Paper, magnifier,
           pencil, clock poke out of the open flap. Reads as "the kit." -->
      <div class="mx-auto flex justify-center" aria-hidden="true">
        <svg viewBox="0 0 190 132" width="170" height="118" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <!-- satchel body -->
          <path d="M28 58 L 158 56 L 162 120 L 24 122 Z"/>
          <!-- buckle -->
          <rect x="86" y="64" width="14" height="8" rx="1.5"/>
          <path d="M88 72 L 88 78 M 98 72 L 98 78"/>
          <!-- handle -->
          <path d="M74 32 C 78 18, 110 18, 114 32"/>
          <!-- flap (open, leaning back) -->
          <path d="M30 58 L 50 30 L 138 28 L 158 58"/>
          <path d="M50 30 L 138 28" stroke-dasharray="2 3"/>
          <!-- rolled paper -->
          <path d="M44 50 L 42 14 L 56 12 L 56 48"/>
          <path d="M44 22 L 56 22 M 44 30 L 56 30 M 44 38 L 56 38" stroke-width="1.3"/>
          <!-- magnifying glass -->
          <circle cx="80" cy="20" r="9"/>
          <path d="M87 27 L 95 35"/>
          <!-- pencil tilted -->
          <path d="M108 12 L 142 32 L 146 38 L 138 36 L 134 30 Z"/>
          <path d="M138 36 L 142 32"/>
          <!-- small clock -->
          <circle cx="166" cy="36" r="9"/>
          <path d="M166 30 L 166 36 L 171 38"/>
          <!-- ground motion lines -->
          <path d="M10 130 L 32 130 M 152 132 L 178 132" stroke-dasharray="2 4" stroke-width="1.2" style="opacity: 0.45;"/>
        </svg>
      </div>

      <div class="eyebrow mt-6">the agent</div>
      <h1 id="agent-headline" class="h-display-lg mx-auto mt-3 max-w-[820px]">
        What the agent can do <span class="hl">for your users</span>.
      </h1>
      <p class="mx-auto mt-5 max-w-[640px] text-fg-2" style="font-size: 18px; line-height: 1.6;">
        Capable for general work the moment you import the SDK. You add what makes it yours. Below is the floor: every capability your users get before you have written a single tool.
      </p>

      <!-- closing flourish, mirrors Hero's "no setup file" caption -->
      <div class="mt-7 flex items-center justify-center gap-2" style="opacity: 0.7;">
        <svg width="18" height="14" viewBox="0 0 20 16" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 9 L 8 14 L 18 2"/>
        </svg>
        <span class="font-mono" style="font-size: 11px; letter-spacing: 0.06em; color: var(--ms-fg-2);">
          ready on import · no setup · waits for the goal
        </span>
      </div>
    </div>
  </section>

  <!-- NATIVE ABILITIES -->
  <section id="native" class="section">
    <div class="container-x">
      <div class="mx-auto max-w-[820px] text-center">
        <div class="eyebrow">native abilities</div>
        <h2 id="native-headline" class="h-section mt-3">
          Out of the box, before <span class="hl">you wire a tool</span>.
        </h2>
        <p class="mx-auto mt-5 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
          The list below works on day one. You can build the entire feature on top of it and never write a line of glue.
        </p>
      </div>

      <ul class="mx-auto mt-12 grid max-w-[1080px] grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {native.map((cap) => (
          <li class="card p-6">
            <div class="font-mono text-fg-3" style="font-size: 12px; letter-spacing: 0.06em;">{cap.num}</div>
            <h3 id={`native-${cap.num}`} class="mt-2 font-medium text-fg-1" style="font-size: 17px; line-height: 1.3; letter-spacing: -0.015em;">
              {cap.title}
            </h3>
            <p class="mt-2.5 text-fg-2" style="font-size: 14px; line-height: 1.6;">{cap.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- EXTENDED ABILITIES -->
  <section id="extended" class="section">
    <div class="container-x">
      <div class="mx-auto grid max-w-[1040px] grid-cols-1 items-center gap-12 md:grid-cols-[1fr_240px] md:gap-14">
        <div>
          <div class="eyebrow">extended abilities</div>
          <h2 id="extended-headline" class="h-section mt-3 max-w-[520px]">
            The ceiling is <span class="hl">whatever you wire up</span>.
          </h2>
          <p class="mt-5 max-w-[520px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
            Everything above is the floor. The agent's reach grows with the tools you hand it. A tool is a function you describe. The agent picks it up like any other capability.
          </p>

          <ul class="mt-7 flex flex-col gap-3" role="list">
            <li class="flex items-baseline gap-3 text-fg-1" style="font-size: 15px; line-height: 1.55;">
              <span aria-hidden="true" class="font-mono text-fg-3">+</span>
              <span>Call your APIs.</span>
            </li>
            <li class="flex items-baseline gap-3 text-fg-1" style="font-size: 15px; line-height: 1.55;">
              <span aria-hidden="true" class="font-mono text-fg-3">+</span>
              <span>Reach into the services your user has connected.</span>
            </li>
            <li class="flex items-baseline gap-3 text-fg-1" style="font-size: 15px; line-height: 1.55;">
              <span aria-hidden="true" class="font-mono text-fg-3">+</span>
              <span>Take actions in your product. Create records, send messages, update state.</span>
            </li>
            <li class="flex items-baseline gap-3 text-fg-1" style="font-size: 15px; line-height: 1.55;">
              <span aria-hidden="true" class="font-mono text-fg-3">+</span>
              <span>Reach third-party services through tools you define.</span>
            </li>
            <li class="flex items-baseline gap-3 text-fg-1" style="font-size: 15px; line-height: 1.55;">
              <span aria-hidden="true" class="font-mono text-fg-3">+</span>
              <span>Anything you can write as a function.</span>
            </li>
          </ul>
        </div>

        <!-- Doodle: two function-signature boxes plug into a lime agent orb.
             "A tool is a function you describe" said visually. -->
        <div class="hidden md:flex md:items-center md:justify-center" aria-hidden="true">
          <svg viewBox="0 0 220 170" width="220" height="170" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <!-- function box A -->
            <rect x="6" y="14" width="100" height="46" rx="4"/>
            <path d="M14 26 L 96 26" stroke-width="1.3"/>
            <path d="M14 36 L 86 36 M 14 44 L 70 44 M 14 52 L 88 52" stroke-width="1.3"/>
            <!-- cable A -->
            <path d="M106 38 C 130 38, 130 76, 154 76"/>
            <path d="M148 72 L 154 76 L 148 80"/>
            <!-- function box B -->
            <rect x="10" y="108" width="86" height="40" rx="4"/>
            <path d="M18 118 L 86 118 M 18 126 L 70 126 M 18 134 L 80 134" stroke-width="1.3"/>
            <!-- cable B -->
            <path d="M96 128 C 124 124, 130 100, 156 96"/>
            <path d="M150 92 L 156 96 L 152 102"/>
            <!-- agent orb -->
            <circle cx="180" cy="86" r="28" fill="#D7F25C"/>
            <circle cx="180" cy="86" r="28"/>
            <path d="M168 80 L 192 80 M 168 88 L 192 88 M 168 96 L 184 96" stroke-width="1.4"/>
          </svg>
        </div>
      </div>

      <p
        class="mx-auto mt-14 max-w-[760px] text-center font-medium text-fg-1"
        style="font-size: clamp(20px, 2.2vw, 26px); line-height: 1.3; letter-spacing: -0.02em; text-wrap: balance;"
      >
        If you can describe it as a function, <span class="hl-soft">the agent can use it</span>.
      </p>
    </div>
  </section>

  <!-- HOW IT RUNS -->
  <section id="modes" class="section border-t border-border-subtle">
    <div class="container-x">
      <div class="mx-auto max-w-[820px] text-center">
        <div class="eyebrow">how it runs</div>
        <h2 id="modes-headline" class="h-section mt-3">
          Same agent. <span class="hl">Four ways it shows up</span>.
        </h2>
      </div>

      <div class="mx-auto mt-12 grid max-w-[1080px] grid-cols-1 gap-5 md:grid-cols-2">
        <article class="card p-7">
          <div class="flex items-start gap-5">
            <svg viewBox="0 0 60 60" width="56" height="56" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
              <circle cx="30" cy="30" r="22"/>
              <path d="M30 30 L 42 18"/>
              <path d="M38 14 L 42 18 L 46 14" stroke-width="1.3"/>
              <circle cx="30" cy="30" r="2.5" fill="#111"/>
            </svg>
            <div class="min-w-0">
              <div class="eyebrow">on demand</div>
              <h3 id="mode-on-demand" class="mt-1 font-medium text-fg-1" style="font-size: 18px; line-height: 1.3; letter-spacing: -0.015em;">Your user asks. The agent answers.</h3>
              <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">The classic shape. They type, click, or send a message. The agent takes the goal and comes back with the result.</p>
            </div>
          </div>
        </article>

        <article class="card p-7">
          <div class="flex items-start gap-5">
            <svg viewBox="0 0 60 60" width="56" height="56" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
              <rect x="8" y="14" width="44" height="38" rx="2"/>
              <path d="M8 24 L 52 24"/>
              <path d="M18 10 L 18 18 M 42 10 L 42 18"/>
              <circle cx="22" cy="34" r="1.6" fill="#111"/>
              <circle cx="38" cy="34" r="1.6" fill="#111"/>
              <circle cx="30" cy="42" r="3" fill="#D7F25C"/>
              <circle cx="30" cy="42" r="3"/>
            </svg>
            <div class="min-w-0">
              <div class="eyebrow">scheduled</div>
              <h3 id="mode-scheduled" class="mt-1 font-medium text-fg-1" style="font-size: 18px; line-height: 1.3; letter-spacing: -0.015em;">Cron-style. Runs on its own.</h3>
              <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">Sunday-morning monitors, weekly digests, daily refreshes. The agent runs while your users sleep.</p>
            </div>
          </div>
        </article>

        <article class="card p-7">
          <div class="flex items-start gap-5">
            <svg viewBox="0 0 60 60" width="56" height="56" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
              <path d="M6 32 C 12 16, 22 48, 30 32 C 36 20, 44 32, 50 32"/>
              <circle cx="50" cy="32" r="4" fill="#111"/>
              <path d="M48 22 L 52 18 M 50 26 L 56 22" stroke-width="1.3"/>
            </svg>
            <div class="min-w-0">
              <div class="eyebrow">webhook-triggered</div>
              <h3 id="mode-webhook" class="mt-1 font-medium text-fg-1" style="font-size: 18px; line-height: 1.3; letter-spacing: -0.015em;">An event hits. The agent picks it up.</h3>
              <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">New email, new payment, new ticket, new row in a table. The agent reacts before your user does.</p>
            </div>
          </div>
        </article>

        <article class="card p-7">
          <div class="flex items-start gap-5">
            <svg viewBox="0 0 60 60" width="56" height="56" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
              <path d="M14 8 L 46 8 L 46 22 L 30 30 L 14 22 Z"/>
              <path d="M14 52 L 46 52 L 46 38 L 30 30 L 14 38 Z"/>
              <path d="M10 8 L 50 8 M 10 52 L 50 52"/>
              <path d="M30 16 L 30 22 M 26 18 L 34 18" stroke-width="1.3"/>
            </svg>
            <div class="min-w-0">
              <div class="eyebrow">background</div>
              <h3 id="mode-background" class="mt-1 font-medium text-fg-1" style="font-size: 18px; line-height: 1.3; letter-spacing: -0.015em;">Long work that does not block the user.</h3>
              <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">They keep using your product. The agent does the slow thing on the side. Comes back when it is done.</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- OUTPUTS -->
  <section id="outputs" class="section">
    <div class="container-x">
      <div class="mx-auto max-w-[820px] text-center">
        <div class="eyebrow">outputs</div>
        <h2 id="outputs-headline" class="h-section mt-3">
          What your users <span class="hl">actually see</span>.
        </h2>
        <p class="mx-auto mt-5 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
          Every run ends with something tangible. Below are the shapes that land in your user's screen, inbox, or feed.
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-[1100px] grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <!-- 1. research doc -->
        <article class="card p-6">
          <div class="rounded-[10px] bg-sunken p-5" aria-hidden="true">
            <svg viewBox="0 0 200 110" width="100%" height="100" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" preserveAspectRatio="xMidYMid meet">
              <rect x="22" y="8" width="156" height="94" rx="3" fill="#FFFFFF"/>
              <path d="M30 22 L 130 22" stroke-width="2.4"/>
              <path d="M30 32 L 156 32 M 30 42 L 168 42 M 30 52 L 152 52 M 30 62 L 162 62 M 30 72 L 144 72"/>
              <circle cx="30" cy="86" r="2" fill="#111"/>
              <path d="M36 88 L 132 88 M 36 96 L 110 96" stroke-width="1.2" style="opacity: 0.6;"/>
            </svg>
          </div>
          <div class="eyebrow mt-4">document</div>
          <h3 id="output-research" class="mt-1 font-medium text-fg-1" style="font-size: 16px; line-height: 1.3; letter-spacing: -0.015em;">A research write-up.</h3>
          <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">Title, sections, body prose, citations linking back to where each fact came from.</p>
        </article>

        <!-- 2. structured data -->
        <article class="card p-6">
          <div class="rounded-[10px] bg-sunken p-5" aria-hidden="true">
            <svg viewBox="0 0 200 110" width="100%" height="100" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" preserveAspectRatio="xMidYMid meet">
              <rect x="22" y="8" width="156" height="94" rx="3" fill="#FFFFFF"/>
              <path d="M22 28 L 178 28" stroke-width="1.6"/>
              <path d="M68 8 L 68 102 M 122 8 L 122 102"/>
              <path d="M30 18 L 60 18 M 76 18 L 114 18 M 130 18 L 168 18"/>
              <path d="M30 40 L 56 40 M 76 40 L 110 40 M 130 40 L 158 40"/>
              <path d="M22 52 L 178 52" style="opacity: 0.5;"/>
              <path d="M30 62 L 58 62 M 76 62 L 114 62 M 130 62 L 162 62"/>
              <path d="M22 74 L 178 74" style="opacity: 0.5;"/>
              <path d="M30 84 L 54 84 M 76 84 L 108 84 M 130 84 L 152 84"/>
            </svg>
          </div>
          <div class="eyebrow mt-4">data</div>
          <h3 id="output-data" class="mt-1 font-medium text-fg-1" style="font-size: 16px; line-height: 1.3; letter-spacing: -0.015em;">Structured rows.</h3>
          <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">Whatever shape you specified. Validated. Ready to drop into your database.</p>
        </article>

        <!-- 3. code file -->
        <article class="card p-6">
          <div class="rounded-[10px] bg-sunken p-5" aria-hidden="true">
            <svg viewBox="0 0 200 110" width="100%" height="100" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" preserveAspectRatio="xMidYMid meet">
              <path d="M22 8 L 152 8 L 178 28 L 178 102 L 22 102 Z" fill="#FFFFFF"/>
              <path d="M152 8 L 152 28 L 178 28"/>
              <path d="M32 44 L 76 44 M 80 44 L 128 44"/>
              <path d="M40 56 L 86 56 M 90 56 L 136 56 M 140 56 L 158 56"/>
              <path d="M40 68 L 96 68 M 100 68 L 130 68"/>
              <path d="M48 80 L 94 80 M 98 80 L 124 80"/>
              <path d="M32 92 L 50 92"/>
            </svg>
          </div>
          <div class="eyebrow mt-4">code</div>
          <h3 id="output-code" class="mt-1 font-medium text-fg-1" style="font-size: 16px; line-height: 1.3; letter-spacing: -0.015em;">A code file.</h3>
          <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">Generated for the task at hand. Your user can download it, run it, or push it into a repo.</p>
        </article>

        <!-- 4. digest email -->
        <article class="card p-6">
          <div class="rounded-[10px] bg-sunken p-5" aria-hidden="true">
            <svg viewBox="0 0 200 110" width="100%" height="100" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" preserveAspectRatio="xMidYMid meet">
              <path d="M22 22 L 178 22 L 178 96 L 22 96 Z" fill="#FFFFFF"/>
              <path d="M22 22 L 100 64 L 178 22"/>
              <path d="M40 14 L 124 14" stroke-width="1.6"/>
              <path d="M40 78 L 130 78 M 40 86 L 110 86" style="opacity: 0.5;"/>
            </svg>
          </div>
          <div class="eyebrow mt-4">email</div>
          <h3 id="output-digest" class="mt-1 font-medium text-fg-1" style="font-size: 16px; line-height: 1.3; letter-spacing: -0.015em;">A scheduled digest.</h3>
          <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">Lands in your user's inbox every Sunday morning. Reads like a member of your team wrote it.</p>
        </article>

        <!-- 5. monitoring alert -->
        <article class="card p-6">
          <div class="rounded-[10px] bg-sunken p-5" aria-hidden="true">
            <svg viewBox="0 0 200 110" width="100%" height="100" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" preserveAspectRatio="xMidYMid meet">
              <path d="M52 38 C 52 26, 62 16, 74 16 C 86 16, 96 26, 96 38 L 98 58 L 104 66 L 44 66 L 50 58 Z" fill="#FFFFFF"/>
              <path d="M68 72 C 68 78, 80 78, 80 72"/>
              <path d="M30 22 L 38 26 M 30 50 L 38 46" stroke-width="1.3"/>
              <rect x="116" y="32" width="68" height="46" rx="3" fill="#D7F25C"/>
              <rect x="116" y="32" width="68" height="46" rx="3"/>
              <path d="M124 44 L 174 44 M 124 52 L 168 52 M 124 60 L 162 60" stroke-width="1.3"/>
            </svg>
          </div>
          <div class="eyebrow mt-4">alert</div>
          <h3 id="output-alert" class="mt-1 font-medium text-fg-1" style="font-size: 16px; line-height: 1.3; letter-spacing: -0.015em;">A monitoring alert.</h3>
          <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">Fires when the agent's check trips. Goes wherever your alerts already go.</p>
        </article>

        <!-- 6. action confirmation -->
        <article class="card p-6">
          <div class="rounded-[10px] bg-sunken p-5" aria-hidden="true">
            <svg viewBox="0 0 200 110" width="100%" height="100" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" preserveAspectRatio="xMidYMid meet">
              <path d="M52 8 L 132 8 L 132 96 L 124 92 L 116 96 L 108 92 L 100 96 L 92 92 L 84 96 L 76 92 L 68 96 L 60 92 L 52 96 Z" fill="#FFFFFF"/>
              <path d="M62 24 L 122 24" stroke-width="1.6"/>
              <path d="M62 38 L 122 38 M 62 48 L 116 48 M 62 58 L 124 58 M 62 68 L 110 68"/>
              <circle cx="156" cy="76" r="20" fill="#D7F25C"/>
              <circle cx="156" cy="76" r="20"/>
              <path d="M147 76 L 154 84 L 166 66" stroke-width="2"/>
            </svg>
          </div>
          <div class="eyebrow mt-4">confirmation</div>
          <h3 id="output-action" class="mt-1 font-medium text-fg-1" style="font-size: 16px; line-height: 1.3; letter-spacing: -0.015em;">An action confirmation.</h3>
          <p class="mt-2 text-fg-2" style="font-size: 14px; line-height: 1.6;">The agent did the thing in your product. Receipt, with the steps it took.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section id="use-cases" class="section border-t border-border-subtle">
    <div class="container-x">
      <div class="mx-auto max-w-[820px] text-center">
        <div class="eyebrow">use cases</div>
        <h2 id="use-cases-headline" class="h-section mt-3">
          Six shapes <span class="hl">developers ship most</span>.
        </h2>
        <p class="mx-auto mt-5 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
          What you build is up to you. The shapes below come up most often.
        </p>
      </div>

      <ul class="mx-auto mt-12 grid max-w-[1080px] grid-cols-1 gap-5 md:grid-cols-2" role="list">
        {useCases.map((uc) => (
          <li class="card p-7">
            <div class="eyebrow">{uc.eyebrow}</div>
            <h3 id={`uc-${uc.id}`} class="mt-1.5 font-medium text-fg-1" style="font-size: 19px; line-height: 1.3; letter-spacing: -0.015em;">
              {uc.title}
            </h3>
            <p class="mt-2.5 text-fg-2" style="font-size: 15px; line-height: 1.6;">{uc.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ClosingPanel
    eyebrow="ship"
    primaryHref="https://platform.midsphere.ai"
    primaryLabel="Start building"
    secondaryHref="/exo"
    secondaryLabel="Read the docs"
    headingId="agent-closing-headline"
  >
    <Fragment slot="headline">
      Pick one of these.<br /><span class="hl text-on-inverse-1">Ship it this week</span>.
    </Fragment>
    <Fragment slot="body">
      Every capability above is wired up the moment you import the SDK. The longest part is deciding which feature your users need first.
    </Fragment>
  </ClosingPanel>
</PageLayout>
