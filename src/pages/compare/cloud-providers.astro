---
import PageLayout from '../../layouts/PageLayout.astro';
import ScrollDownArrow from '../../components/ui/ScrollDownArrow.astro';
import CloudProviderPageDoodle from '../../components/ui/CloudProviderPageDoodle.astro';
import CloudPlatformLayerDoodle from '../../components/ui/CloudPlatformLayerDoodle.astro';
import FitFramework from '../../components/ui/FitFramework.astro';
import ScenarioCard from '../../components/ui/ScenarioCard.astro';
import ClosingPanel from '../../components/ui/ClosingPanel.astro';

interface PlatformPiece {
  num: string;
  title: string;
  body: string;
  doodle: 'controls' | 'schedule' | 'analytics' | 'definitions' | 'components';
}

// The five platform-layer pieces a managed runtime won’t ship for you.
const platformLayer: PlatformPiece[] = [
  {
    num: '01',
    title: 'Per-user controls.',
    body: 'Credits, rate limits, sandbox time, model tier access, tool access. Set once, applied per user. Every product surface needs this layer and no managed runtime ships it for you.',
    doodle: 'controls',
  },
  {
    num: '02',
    title: 'Scheduled runs.',
    body: 'The agent fires on a cron, not just on a button click. The Sunday-morning report. The end-of-month digest. The 6am inbox sweep that lands before the customer is awake.',
    doodle: 'schedule',
  },
  {
    num: '03',
    title: 'An analytics agent.',
    body: 'A second agent reads your logs, ratings, and cost data and tells you which runs are working and which aren’t. The dashboard you’d otherwise build yourself, watching itself.',
    doodle: 'analytics',
  },
  {
    num: '04',
    title: 'Centralized definitions.',
    body: 'Tools and knowledge live in one editable surface. A non-engineer can correct a tool description or update a knowledge file without a deploy.',
    doodle: 'definitions',
  },
  {
    num: '05',
    title: 'UI components.',
    body: 'A small component library for the agent surface. Conversation, attachments, run history, approval prompts. So your team isn’t pixel-pushing chat bubbles in week one.',
    doodle: 'components',
  },
];

const cloudFit: string[] = [
  'You’re already deeply committed to a cloud and want agent compute on the same bill.',
  'You want to write the agent loop yourself and have the engineering team to do it.',
  'You need procurement, compliance, and security review specific to that cloud.',
];

const midsphereFit: string[] = [
  'You want to ship an agent feature without writing an agent.',
  'You want per-user controls, analytics, and UI components shipped alongside the agent.',
  'You’d rather focus on your product than on the agent infrastructure around it.',
];
---

<PageLayout
  title="Midsphere vs. managed agent runtimes · Compare"
  description="AWS Bedrock AgentCore, Azure AI Foundry, Google Vertex AI Agent Builder, and Anthropic Claude Managed Agents are managed runtimes for the agent your team writes. Midsphere ships the agent itself, plus the platform to run it as a product. Here’s how to tell which fits."
  breadcrumbs={[
    { name: 'Home', url: 'https://midsphere.ai' },
    { name: 'Compare', url: 'https://midsphere.ai/compare' },
    { name: 'Cloud providers', url: 'https://midsphere.ai/compare/cloud-providers' },
  ]}
>
  <section id="compare-cloud" class="section-tight pt-12 lg:pt-16">
    <div class="container-x text-center">
      <div class="eyebrow">compare · managed agent runtimes</div>
      <h1 id="hero-headline" class="h-display-lg mx-auto mt-3 max-w-[860px]">
        They host your agent. <span class="hl">We ship the agent</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-[660px] text-fg-1" style="font-size: 18px; line-height: 1.65;">
        AWS Bedrock AgentCore, Azure AI Foundry, Google Vertex AI Agent Builder, and Anthropic Claude Managed Agents are managed runtimes for the agent your team writes.
      </p>
      <p class="mx-auto mt-4 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.65;">
        Midsphere is a different category. We ship the agent itself, plus the platform to run it as a product.
      </p>
      <div class="mx-auto mt-12 flex justify-center">
        <ScrollDownArrow />
      </div>
    </div>
  </section>

  <section id="strengths" class="section">
    <div class="container-x">
      <div class="mx-auto max-w-[680px] text-center">
        <div class="eyebrow">the managed-runtime category</div>
        <h2 id="strengths-headline" class="h-section mt-3">
          What these platforms <span class="hl-soft">do well</span>.
        </h2>
        <p class="mx-auto mt-5 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
          Real products, built by serious teams. If your situation lines up, they’re reasonable choices.
        </p>
      </div>

      <ul class="mx-auto mt-12 grid max-w-[1080px] grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-4" role="list">
        <li class="rounded-[14px] border border-border-subtle bg-canvas p-6">
          <div class="eyebrow">cloud integration</div>
          <p class="mt-3 text-fg-2" style="font-size: 14.5px; line-height: 1.6;">
            If you’re already on AWS, Azure, or GCP, the agent runs next to the data warehouse, identity, and network you already use.
          </p>
        </li>
        <li class="rounded-[14px] border border-border-subtle bg-canvas p-6">
          <div class="eyebrow">enterprise compliance</div>
          <p class="mt-3 text-fg-2" style="font-size: 14.5px; line-height: 1.6;">
            Mature security review, regional deployment, audit logging, and the procurement paperwork your CISO wants on file.
          </p>
        </li>
        <li class="rounded-[14px] border border-border-subtle bg-canvas p-6">
          <div class="eyebrow">engineering scale</div>
          <p class="mt-3 text-fg-2" style="font-size: 14.5px; line-height: 1.6;">
            Hyperscaler engineering and balance sheets behind the runtime. The platforms aren’t going anywhere.
          </p>
        </li>
        <li class="rounded-[14px] border border-border-subtle bg-canvas p-6">
          <div class="eyebrow">existing relationship</div>
          <p class="mt-3 text-fg-2" style="font-size: 14.5px; line-height: 1.6;">
            If your account team already knows your spend, the agent runtime drops into a conversation that’s already happening.
          </p>
        </li>
      </ul>

      <div class="mx-auto mt-10 grid max-w-[1080px] grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
        <article class="rounded-[14px] border border-border-subtle bg-canvas p-7 sm:p-8">
          <div class="eyebrow">specifically · agentcore</div>
          <h3 id="agentcore-note" class="mt-3 font-medium text-fg-1" style="font-size: 19px; line-height: 1.25; letter-spacing: -0.02em;">
            Multi-framework by design.
          </h3>
          <p class="mt-3 text-fg-2" style="font-size: 15.5px; line-height: 1.65;">
            AgentCore runs LangGraph, CrewAI, Strands, and the OpenAI Agents SDK side by side. <span class="hl-soft">If you’re writing your own agent and want a runtime that doesn’t lock you in</span>, that’s a real argument.
          </p>
        </article>
        <article class="rounded-[14px] border border-border-subtle bg-canvas p-7 sm:p-8">
          <div class="eyebrow">specifically · claude managed agents</div>
          <h3 id="claude-note" class="mt-3 font-medium text-fg-1" style="font-size: 19px; line-height: 1.25; letter-spacing: -0.02em;">
            Per-session pricing, tight Claude integration.
          </h3>
          <p class="mt-3 text-fg-2" style="font-size: 15.5px; line-height: 1.65;">
            Pricing maps cleanly to your existing Anthropic API spend, and the agent rides the same model your team is already evaluating against. <a href="/compare/claude-managed-agents" class="text-fg-1 underline decoration-fg-3 underline-offset-2 hover:decoration-fg-1">Deeper read on the Anthropic question →</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section id="midsphere-side" class="section border-t border-border-subtle">
    <div class="container-x">
      <div class="mx-auto max-w-[700px] text-center">
        <div class="eyebrow">a different category</div>
        <h2 id="midsphere-headline" class="h-section mt-3">
          We are the agent. <span class="hl">And the platform around it</span>.
        </h2>
      </div>

      <div class="mx-auto mt-12 grid max-w-[1080px] grid-cols-1 items-center gap-10 md:grid-cols-[1fr_320px] md:gap-14">
        <div>
          <p class="text-fg-1" style="font-size: 17px; line-height: 1.7;">
            Midsphere isn’t where you host the agent you wrote. It is the agent. A multi-agent system that already does the long-running work, picks tools, recovers from its own failures, and lets you steer it mid-run.
          </p>
          <p class="mt-4 text-fg-2" style="font-size: 16px; line-height: 1.7;">
            You don’t write the agent loop. You wire your tools and knowledge in, set policies in plain language, and call <code class="font-mono text-fg-1" style="font-size: 0.92em;">agent.run</code>. <span class="hl-soft">Same afternoon you sign up.</span>
          </p>
        </div>
        <figure class="flex justify-center" aria-labelledby="horizon-caption">
          <CloudProviderPageDoodle kind="horizon" />
        </figure>
      </div>
      <p id="horizon-caption" class="mx-auto mt-6 max-w-[560px] text-center font-mono text-fg-3" style="font-size: 12px; letter-spacing: 0.04em;">
        above the line: your product · below the line: the agent and the platform around it
      </p>

      <div class="mx-auto mt-20 max-w-[680px] text-center">
        <div class="eyebrow">the platform around the agent</div>
        <h3 id="platform-headline" class="h-section mt-3">
          Five things <span class="hl">a runtime won’t ship for you</span>.
        </h3>
        <p class="mx-auto mt-5 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
          Cloud runtimes don’t ship these because they sell compute, and compute doesn’t need any of it. The pieces below are the difference between hosting an agent and shipping an agent product.
        </p>
      </div>

      <ul class="mx-auto mt-12 grid max-w-[1080px] grid-cols-1 gap-5 md:grid-cols-2 md:gap-6 lg:grid-cols-3" role="list">
        {platformLayer.map((p) => (
          <li class="rounded-[14px] border border-border-subtle bg-canvas p-6 sm:p-7">
            <div class="flex h-[88px] items-center" aria-hidden="true">
              <CloudPlatformLayerDoodle kind={p.doodle} />
            </div>
            <div class="mt-4 flex items-baseline gap-3">
              <span class="font-mono text-fg-3" style="font-size: 12px; letter-spacing: 0.06em;">{p.num}</span>
              <span class="font-mono text-fg-3" style="font-size: 12px; letter-spacing: 0.06em;">we ship</span>
            </div>
            <h4 id={`platform-${p.num}`} class="mt-2 font-medium text-fg-1" style="font-size: 19px; letter-spacing: -0.02em;">
              {p.title}
            </h4>
            <p class="mt-3 text-fg-2" style="font-size: 14.5px; line-height: 1.6;">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="fit" class="section border-t border-border-subtle">
    <div class="container-x">
      <div class="mx-auto max-w-[600px] text-center">
        <div class="eyebrow">which one fits</div>
        <h2 id="fit-headline" class="h-section mt-3">
          Pick the column that <span class="hl">sounds like your team</span>.
        </h2>
      </div>

      <FitFramework
        leftLabel="choose a managed runtime if"
        leftItems={cloudFit}
        rightLabel="choose midsphere if"
        rightItems={midsphereFit}
      >
        <svg slot="leftIcon" viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="8" width="22" height="18" rx="2"/>
          <path d="M12 8 L 12 26 M 20 8 L 20 26" stroke-width="1.2"/>
        </svg>
        <svg slot="rightIcon" viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="16" cy="16" r="11"/>
          <path d="M11 16 L 15 20 L 22 12" stroke-width="1.4"/>
        </svg>
      </FitFramework>
    </div>
  </section>

  <section id="scenarios" class="section">
    <div class="container-x">
      <div class="mx-auto max-w-[640px] text-center">
        <div class="eyebrow">in practice</div>
        <h2 id="scenarios-headline" class="h-section mt-3">
          How this lands for <span class="hl-soft">two different teams</span>.
        </h2>
      </div>

      <div class="mx-auto mt-12 grid max-w-[1080px] grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
        <ScenarioCard
          num="01"
          title="800-engineer enterprise. All-AWS. Internal agent service."
          body="Platform team with AI engineers, a multi-year AWS contract, and a security review that already trusts Bedrock. They want to own the agent design and run it on the same bill as the rest of their platform."
          verdictHighlight="Bedrock AgentCore is the right call."
          verdict="They want the runtime, not the agent."
          headingId="scenario-platform"
        >
          <CloudProviderPageDoodle slot="doodle" kind="tower" />
        </ScenarioCard>

        <ScenarioCard
          num="02"
          title="8-person SaaS. AI feature on the roadmap. Live this quarter."
          body="One or two of them used to write Python. None of them wants to be an AI engineer. The feature is one item on a long product roadmap, and the team needs it shipped before the quarterly review."
          verdictHighlight="Midsphere is the right call."
          verdict="An afternoon to a working demo, no AI engineer."
          headingId="scenario-startup"
        >
          <CloudProviderPageDoodle slot="doodle" kind="lightbulb" />
        </ScenarioCard>
      </div>
    </div>
  </section>

  <ClosingPanel
    eyebrow="if your job is shipping the feature"
    primaryHref="https://platform.midsphere.ai"
    primaryLabel="Start building"
    secondaryHref="/docs"
    secondaryLabel="Read the docs"
    headingId="ship-headline"
  >
    <Fragment slot="headline">
      Skip the runtime.<br /><span class="hl text-on-inverse-1">Ship the agent</span>.
    </Fragment>
    <Fragment slot="body">
      Cloud runtimes hand you a place to run the agent your team wrote. We hand you the agent itself, and the controls to run it as a real product.
    </Fragment>
  </ClosingPanel>
</PageLayout>
