---
// Page tuned for vibe coders building on Next.js / Supabase / shadcn.
// Narrative arc, top to bottom:
//   hook → starter (the magic command) → useAgent (the hook) → components
//   (shadcn for agents) → what's already plumbed → drop-in for existing apps
//   → cost (footnote) → closing CTA.
//
// One CTA pattern across the page: "Start building" → platform.midsphere.ai,
// at the hero and the closing panel only. Everything in between is code,
// doodles, or text. No competing buttons.
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
import LightningDoodle from '../components/ui/LightningDoodle.astro';

const starterCmds = `npx create-midsphere-app my-agent
cd my-agent
npm run dev`;

const agentDefCode = `// server: define what the agent can do
import { agent, tool } from "@midsphere/sdk"
import { z } from "zod"

export const research = agent({
  id: "research",
  tools: {
    search: tool({
      input: z.object({ query: z.string() }),
      run: ({ query }) => searchAPI(query),
    }),
  },
})`;

const useAgentCode = `"use client"
import { useAgent } from "@midsphere/sdk/react"
import { research } from "@/agents/research"

export default function Page() {
  const { messages, send, isStreaming } = useAgent(research)
  return <Chat messages={messages} onSend={send} streaming={isStreaming} />
}`;

const dropInCode = `import { Midsphere } from "@midsphere/sdk"

const agent = new Midsphere().agent({ id: "research" })
const result = await agent.run(prompt)`;

const uiCmd = `npx @midsphere/ui add chat`;

const pythonCode = `from midsphere import Agent

agent = Agent(id="research")
result = agent.run(prompt)`;

type MomentKind = 'persistence' | 'approval' | 'schedules' | 'fallback' | 'credits' | 'retries' | 'cost' | 'streaming';

type WeekMoment = { time: string; kind: MomentKind; text: string };

type V1Capability = { kind: MomentKind; label: string };

// TODO(affan): fill in real labels for the v1 capabilities grid.
const v1Capabilities: V1Capability[] = [];

const weekMoments: WeekMoment[] = [
  {
    time: 'sat 6pm',
    kind: 'persistence',
    text: "A user closes the tab and comes back two hours later. The conversation is exactly where they left it. You wrote zero database code.",
  },
  {
    time: 'sun 9am',
    kind: 'approval',
    text: "The agent goes to send an email. It pauses, surfaces a button, waits. You set 'send_email' as approval-required. That was the whole policy.",
  },
  {
    time: 'mon 7am',
    kind: 'schedules',
    text: "A weekly digest fires for every user, in their timezone. The agent ran in the background. You don't maintain a worker.",
  },
  {
    time: 'tue 3pm',
    kind: 'fallback',
    text: "Upstream is down for forty minutes. Your users see no errors. The fallback model picked up. You learn about it on Twitter, hours later.",
  },
  {
    time: 'wed 11am',
    kind: 'credits',
    text: "A user hits the daily limit. Their next message tells them why, in your voice. You wrote zero rate-limiting code.",
  },
  {
    time: 'fri 8am',
    kind: 'cost',
    text: "The cost meter says $4.18 for the week, 137 conversations. You sleep on it.",
  },
];
---

<PageLayout
  title="For vibe coders · Next.js, Supabase, shadcn · Midsphere"
  description="Vibe code an agent app on Next.js, Supabase, and shadcn. One command. TypeScript SDK. Components that copy into your repo."
  breadcrumbs={[
    { name: 'Home', url: 'https://midsphere.ai' },
    { name: 'For vibe coders', url: 'https://midsphere.ai/for-vibe-coders' },
  ]}
>
  <!-- ───────────────────────────────────────────────────────────── HERO -->
  <section id="vc-hero" class="pt-12 pb-16 text-center lg:pt-16 lg:pb-20">
    <div class="container-x">
      <!-- Hero doodle. The stack-frames carry the structural argument
           (your Next.js / Supabase / shadcn layers, plus a lime agent
           badge snapping in). The coffee mug parked next to them carries
           the personal one — this page reads to someone who builds at
           odd hours, between sips. The mug is small, off to the side,
           steam curling. Personality without competing with the stack. -->
      <div class="mx-auto flex items-end justify-center gap-4 doodle-float" aria-hidden="true">
        <svg viewBox="0 0 220 130" width="180" height="106" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="22" y="64" width="138" height="44" rx="3"/>
          <rect x="34" y="50" width="138" height="44" rx="3"/>
          <rect x="46" y="36" width="138" height="44" rx="3"/>
          <rect x="58" y="22" width="138" height="44" rx="3"/>
          <path d="M68 32 L 184 32 M 68 38 L 174 38 M 68 44 L 178 44 M 68 50 L 168 50 M 68 56 L 180 56"/>
          <circle cx="194" cy="22" r="14" fill="#D7F25C"/>
          <circle cx="194" cy="22" r="14"/>
          <path d="M188 22 L 192 26 L 200 16" stroke-width="1.6"/>
        </svg>
        <!-- coffee mug, steaming -->
        <svg viewBox="0 0 80 100" width="56" height="70" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 8px;">
          <path d="M14 50 L 14 86 C 14 92, 18 96, 24 96 L 50 96 C 56 96, 60 92, 60 86 L 60 50 Z"/>
          <path d="M60 56 C 70 56, 74 64, 74 72 C 74 80, 70 86, 60 86"/>
          <path d="M14 50 L 60 50"/>
          <!-- steam curls -->
          <path d="M26 38 C 26 32, 32 32, 32 26 C 32 20, 26 20, 26 14"/>
          <path d="M40 38 C 40 32, 46 32, 46 26 C 46 20, 40 20, 40 14"/>
        </svg>
      </div>

      <h1
        id="vc-headline"
        class="h-display mx-auto mt-6 max-w-[820px] text-fg-1"
      >It's <span class="hl">2am</span>. You're shipping an agent app.</h1>

      <p
        class="mx-auto mt-5 max-w-[640px] text-fg-2"
        style="font-size: 18px; line-height: 1.55;"
      >
        Next.js 15. Supabase Auth. shadcn UI. The agent piece type-safe end-to-end, streaming over server actions, edge-ready. One command and you're prompting.
      </p>

      <div class="relative mx-auto mt-9 inline-block">
        <Button href="https://platform.midsphere.ai" variant="primary">Start building</Button>

        <!-- Left annotation. Sits BESIDE the button (vertically centered
             on it). SVG on top, caption below. Arrow ends at the SVG's
             right edge with the chevron apex pointing right INTO the
             button. Stays out of the subhead vertically. -->
        <div
          class="hidden lg:block"
          aria-hidden="true"
          style="position: absolute; top: -6px; right: calc(100% + 14px); width: 172px; transform: rotate(2deg);"
        >
          <svg width="148" height="40" viewBox="0 0 148 40" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="display: block; margin-left: auto;">
            <path d="M8 8 C 36 14, 88 18, 138 22"/>
            <path d="M132 16 L 142 22 L 132 28"/>
          </svg>
          <p class="font-mono" style="font-size: 12px; line-height: 1.45; color: var(--ms-fg-2); text-align: right; margin-top: 4px;">
            your shadcn theme · still yours.
          </p>
        </div>

        <!-- Right annotation. Mirror: arrow ends at SVG's left edge,
             chevron apex pointing left INTO the button. -->
        <div
          class="hidden lg:block"
          aria-hidden="true"
          style="position: absolute; top: -6px; left: calc(100% + 14px); width: 172px; transform: rotate(-2deg);"
        >
          <svg width="148" height="40" viewBox="0 0 148 40" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="display: block;">
            <path d="M140 8 C 112 14, 60 18, 10 22"/>
            <path d="M16 16 L 6 22 L 16 28"/>
          </svg>
          <p class="font-mono" style="font-size: 12px; line-height: 1.45; color: var(--ms-fg-2); text-align: left; margin-top: 4px;">
            no yaml. no 'pick a model'.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- ─────────────────────────────────────────────────── ONE COMMAND -->
  <section id="starter" class="section border-t border-border-subtle">
    <div class="container-x">
      <!-- Stopwatch + command-card doodle. The stopwatch hand is sweeping
           past 60. A small "command" card slides out from the side with
           a `>_` glyph. Says: one command, one minute. -->
      <div class="mx-auto mb-6 flex justify-center" aria-hidden="true">
        <svg viewBox="0 0 220 110" width="200" height="100" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <!-- stopwatch -->
          <circle cx="78" cy="60" r="36"/>
          <path d="M78 32 L 78 26 M 70 26 L 86 26"/>
          <path d="M104 38 L 110 32"/>
          <!-- tick marks -->
          <path d="M78 30 L 78 34 M 108 60 L 104 60 M 78 90 L 78 86 M 48 60 L 52 60"/>
          <!-- hands sweeping past 60 (top) -->
          <path d="M78 60 L 78 36" stroke-width="1.8"/>
          <path d="M78 60 L 92 50" stroke-width="1.4"/>
          <circle cx="78" cy="60" r="2.4" fill="#111"/>
          <!-- command card sliding out to the right -->
          <rect x="130" y="44" width="78" height="32" rx="4" fill="#FFFFFF"/>
          <rect x="130" y="44" width="78" height="32" rx="4"/>
          <path d="M138 56 L 144 60 L 138 64" stroke-width="1.4"/>
          <path d="M150 64 L 198 64" stroke-width="1.4"/>
          <!-- motion lines connecting -->
          <path d="M114 60 L 128 60" stroke-dasharray="2 3" stroke-width="1.2"/>
          <!-- lime tick badge. The "sixty seconds" claim lands in the
               heading and caption below; the doodle gets a sketched check
               instead of an inline `<text>` glyph (which would orphan as a
               fragment in source-text extraction). -->
          <circle cx="44" cy="34" r="14" fill="#D7F25C"/>
          <circle cx="44" cy="34" r="14"/>
          <path d="M37 34 L 42 39 L 51 28" stroke="#2E3A0A" stroke-width="1.6"/>
        </svg>
      </div>

      <div class="mx-auto max-w-[760px] text-center">
        <div class="eyebrow">one command</div>
        <h2 id="starter-headline" class="h-section mx-auto mt-3 max-w-[680px]">
          Sixty seconds. <span class="hl">From zero to prompting.</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
          One command runs the starter. Auth schema migrates into Supabase. RLS policies land for per-user agent state. The agent endpoint wires through a server action. shadcn theme installs. The streaming chat renders. You're picking a prompt, not picking a model.
        </p>
      </div>

      <div class="mx-auto mt-10 max-w-[640px]">
        <div class="font-mono text-[12px] uppercase mb-2" style="color: var(--ms-fg-3); letter-spacing: 0.08em;">
          terminal
        </div>
        <CodeBlock code={starterCmds} />
      </div>

      <!-- Sketched browser frame. Hand-laid app preview: sidebar of runs,
           streaming chat, composer. Reads as the screen the dev sees on
           first run. -->
      <figure class="mx-auto mt-12 max-w-[820px]">
        <div class="rounded-[14px] border border-border-default bg-canvas overflow-hidden" style="box-shadow: var(--shadow-2);">
          <div class="flex items-center gap-2 border-b border-border-subtle bg-sunken px-4 py-2.5">
            <span class="block h-2.5 w-2.5 rounded-full" style="background: #E5E5E5;"></span>
            <span class="block h-2.5 w-2.5 rounded-full" style="background: #E5E5E5;"></span>
            <span class="block h-2.5 w-2.5 rounded-full" style="background: #E5E5E5;"></span>
            <span class="ml-3 font-mono text-[11px]" style="color: var(--ms-fg-3); letter-spacing: 0.04em;">
              localhost:3000
            </span>
          </div>
          <div class="grid gap-0 sm:grid-cols-[180px_1fr]">
            <aside class="border-b border-border-subtle p-5 sm:border-b-0 sm:border-r" aria-hidden="true">
              <div class="font-mono text-[11px] uppercase" style="color: var(--ms-fg-3); letter-spacing: 0.06em;">runs</div>
              <ul class="mt-3 flex flex-col gap-2.5">
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full" style="background: var(--ms-accent);"></span>
                  <span class="text-[13px] text-fg-1">research · live</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full" style="background: var(--ms-fg-3);"></span>
                  <span class="text-[13px] text-fg-2">draft email</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full" style="background: var(--ms-fg-3);"></span>
                  <span class="text-[13px] text-fg-2">weekly digest</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full" style="background: var(--ms-fg-3);"></span>
                  <span class="text-[13px] text-fg-2">scrape competitors</span>
                </li>
              </ul>
            </aside>

            <div class="p-6" aria-hidden="true">
              <div class="rounded-[10px] bg-sunken px-4 py-3 text-[13px] text-fg-1" style="max-width: 80%;">
                What's the latest on Q4 SaaS pricing trends?
              </div>
              <div class="mt-4 flex items-start gap-2.5" style="max-width: 90%;">
                <div class="h-6 w-6 shrink-0 rounded-full border border-border-default" style="background: var(--ms-accent);"></div>
                <div class="text-[13px] text-fg-1" style="line-height: 1.55;">
                  Pulled twelve sources. Two patterns showed up across them. <span class="font-mono text-[11px]" style="color: var(--ms-fg-3);">searching · 8 sources read · drafting…</span>
                </div>
              </div>
              <div class="mt-6 rounded-[10px] border border-border-subtle p-3 flex items-center gap-2">
                <div class="h-2 flex-1 rounded-full" style="background: var(--ms-bg-sunken);">
                  <div class="h-2 rounded-full" style="width: 100%; background: var(--ms-fg-3); opacity: 0.5;"></div>
                </div>
                <span class="font-mono text-[11px]" style="color: var(--ms-fg-3);">send</span>
              </div>
            </div>
          </div>
        </div>
        <figcaption class="mt-4 text-center font-mono" style="font-size: 11px; color: var(--ms-fg-3); letter-spacing: 0.06em;">
          first run · auth, agent, components, all wired
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ────────────────────────────────────────────────── SDK & TOOLS -->
  <!-- Two code blocks, server then client. The structural argument: same
       agent definition feeds the hook, types flow end-to-end. The body
       copy carries the technical substance, doodle holds the metaphor. -->
  <section id="sdk" class="section">
    <div class="container-x">
      <div class="mx-auto max-w-[760px] text-center">
        <!-- Type-flow doodle. Two boxes (server + client) with a typed
             pipe between them, the pipe carrying labelled "ts" badges.
             Says: same types on both ends. -->
        <div class="mx-auto mb-6 flex justify-center" aria-hidden="true">
          <svg viewBox="0 0 240 80" width="220" height="74" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <!-- left box: server -->
            <rect x="6" y="20" width="64" height="44" rx="3"/>
            <path d="M14 30 L 60 30 M 14 38 L 54 38 M 14 46 L 56 46 M 14 54 L 50 54" stroke-width="1.3"/>
            <!-- right box: client -->
            <rect x="170" y="20" width="64" height="44" rx="3"/>
            <path d="M178 30 L 224 30 M 178 38 L 218 38 M 178 46 L 222 46 M 178 54 L 214 54" stroke-width="1.3"/>
            <!-- typed pipe between, with chevrons indicating bidirectional flow -->
            <path d="M70 38 L 170 38" stroke-dasharray="2 3" stroke-width="1.3"/>
            <path d="M70 48 L 170 48" stroke-dasharray="2 3" stroke-width="1.3"/>
            <!-- lime "ts" pill on the pipe -->
            <rect x="106" y="36" width="28" height="14" rx="7" fill="#D7F25C"/>
            <rect x="106" y="36" width="28" height="14" rx="7"/>
            <path d="M114 43 L 122 43 M 118 40 L 118 46" stroke-width="1.3"/>
            <path d="M124 41 C 124 40, 130 40, 130 42 C 130 44, 124 44, 124 46 C 124 48, 130 48, 130 47" stroke-width="1.2"/>
          </svg>
        </div>

        <div class="eyebrow">sdk &amp; tools</div>
        <h2 id="sdk-headline" class="h-section mx-auto mt-3 max-w-[680px]">
          Tools are functions. <span class="hl">Types flow end-to-end.</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
          Define a tool with Zod. Add it to an agent. Drop the same agent into <code class="font-mono text-[14px]" style="background: var(--ms-bg-sunken); padding: 2px 6px; border-radius: 4px;">useAgent</code> on the client. Tool input and output types follow you all the way to the message that reads <code class="font-mono text-[13px]" style="background: var(--ms-bg-sunken); padding: 2px 6px; border-radius: 4px;">tool · search · 24 results</code>.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-[1080px] grid-cols-1 gap-6 md:grid-cols-2 md:gap-6">
        <div>
          <div class="font-mono text-[12px] uppercase mb-2" style="color: var(--ms-fg-3); letter-spacing: 0.08em;">
            agents/research.ts · server
          </div>
          <CodeBlock code={agentDefCode} />
        </div>
        <div>
          <div class="font-mono text-[12px] uppercase mb-2" style="color: var(--ms-fg-3); letter-spacing: 0.08em;">
            app/(chat)/page.tsx · client
          </div>
          <CodeBlock code={useAgentCode} />
        </div>
      </div>

      <ul class="mx-auto mt-10 grid max-w-[860px] grid-cols-1 gap-x-10 gap-y-3 sm:grid-cols-2">
        {[
          'streaming over server actions, no custom protocol',
          'edge runtime where it pays off',
          'tool retries, timeouts, structured errors built in',
          'tool input + output types inferred into the hook',
        ].map((item) => (
          <li class="flex items-baseline gap-3 text-fg-1" style="font-size: 15px; line-height: 1.5;">
            <span class="font-mono text-[13px]" style="color: var(--ms-fg-3);">·</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ───────────────────────────────────────────────── COMPONENTS -->
  <section id="components" class="section border-t border-border-subtle">
    <div class="container-x">
      <!-- UI-bricks doodle: a chat bubble + button + card stacked, with a
           lime "+" between, suggesting drop-in pieces that compose. -->
      <div class="mx-auto mb-6 flex justify-center" aria-hidden="true">
        <svg viewBox="0 0 220 92" width="200" height="84" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <!-- chat bubble -->
          <path d="M14 18 L 70 16 C 76 16, 80 20, 80 26 L 80 50 C 80 56, 76 60, 70 60 L 38 62 L 28 74 L 30 60 L 18 60 C 12 60, 8 56, 8 50 L 8 24 C 8 18, 12 18, 14 18 Z" fill="#FFFFFF"/>
          <path d="M14 18 L 70 16 C 76 16, 80 20, 80 26 L 80 50 C 80 56, 76 60, 70 60 L 38 62 L 28 74 L 30 60 L 18 60 C 12 60, 8 56, 8 50 L 8 24 C 8 18, 12 18, 14 18 Z"/>
          <path d="M20 30 L 68 30 M 20 38 L 60 38 M 20 46 L 64 46" stroke-width="1.4"/>
          <!-- plus -->
          <path d="M98 36 L 110 36 M 104 30 L 104 42" stroke-width="1.6"/>
          <!-- button pill -->
          <rect x="124" y="22" width="56" height="22" rx="11" fill="#D7F25C"/>
          <rect x="124" y="22" width="56" height="22" rx="11"/>
          <path d="M134 33 L 168 33" stroke-width="1.4"/>
          <!-- card -->
          <rect x="124" y="50" width="80" height="30" rx="3" fill="#FFFFFF"/>
          <rect x="124" y="50" width="80" height="30" rx="3"/>
          <path d="M132 60 L 196 60 M 132 67 L 188 67 M 132 74 L 192 74" stroke-width="1.2"/>
        </svg>
      </div>

      <div class="mx-auto max-w-[760px] text-center">
        <div class="eyebrow">components</div>
        <h2 id="components-headline" class="h-section mx-auto mt-3 max-w-[680px]">
          <span class="hl">shadcn for agents.</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
          @midsphere/ui ships the agent UI parts that are easy to get wrong. Chat. Composer. MessageList. RunViewer. ToolCallBadge. ApprovalPrompt. ArtifactRenderer. CostMeter. RatingWidget. Built on shadcn primitives, your theme, your typography.
        </p>
      </div>

      <div class="mx-auto mt-10 grid max-w-[1080px] grid-cols-1 gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,420px)] md:gap-12">
        <div>
          <div class="font-mono text-[12px] uppercase mb-2" style="color: var(--ms-fg-3); letter-spacing: 0.08em;">
            cli
          </div>
          <CodeBlock code={uiCmd} />
          <p class="mt-5 text-fg-2" style="font-size: 15px; line-height: 1.6;">
            The CLI copies source into your repo, just like shadcn. The file is yours. Open it, edit the markup, swap the icons, change the streaming behavior. <span class="hl-soft">No runtime to upgrade.</span> No version pinned in your <code class="font-mono text-[13px]" style="background: var(--ms-bg-sunken); padding: 2px 6px; border-radius: 4px;">package.json</code>.
          </p>
        </div>

        <!-- streaming chat preview, in-context -->
        <div class="rounded-[14px] border border-border-default bg-canvas p-5" style="box-shadow: var(--shadow-1);">
          <div class="flex items-center justify-between">
            <div class="font-mono text-[11px] uppercase" style="color: var(--ms-fg-3); letter-spacing: 0.06em;">chat · research</div>
            <div class="flex items-center gap-1.5 font-mono text-[11px]" style="color: var(--ms-fg-2);">
              <span class="block h-1.5 w-1.5 rounded-full" style="background: var(--ms-ok);"></span>
              streaming
            </div>
          </div>
          <div class="mt-5 flex flex-col gap-3">
            <div class="rounded-[10px] bg-sunken px-3.5 py-2.5 text-[13px] text-fg-1 self-end" style="max-width: 75%;">
              find me three places under $X near a good school
            </div>
            <div class="flex items-start gap-2.5" style="max-width: 92%;">
              <div class="h-6 w-6 shrink-0 rounded-full" style="background: var(--ms-accent);"></div>
              <div class="text-[13px] text-fg-1" style="line-height: 1.55;">
                Pulling listings now. <span class="font-mono text-[11px]" style="color: var(--ms-fg-3);">tool · searchListings · 24 results</span>
              </div>
            </div>
            <div class="flex items-start gap-2.5" style="max-width: 92%;">
              <div class="h-6 w-6 shrink-0 rounded-full" style="background: var(--ms-accent);"></div>
              <div class="text-[13px] text-fg-1" style="line-height: 1.55;">
                Three matches. Two have tours open this weekend.
                <span aria-hidden="true" class="ml-0.5 inline-block h-3.5 w-1.5 align-middle" style="background: var(--ms-fg-1); animation: vc-blink 1s steps(2, start) infinite;"></span>
              </div>
            </div>
          </div>
          <div class="mt-5 flex items-center gap-2 rounded-[10px] border border-border-subtle px-3 py-2">
            <input class="flex-1 bg-transparent text-[13px] text-fg-1 outline-none" placeholder="Ask anything…" disabled />
            <span class="font-mono text-[11px]" style="color: var(--ms-fg-3);">⏎</span>
          </div>
          <div class="mt-3 flex items-center justify-between font-mono text-[11px]" style="color: var(--ms-fg-3);">
            <span>cost · $0.014</span>
            <span>tokens · 1,284</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────── A WEEK WITH MIDSPHERE -->
  <!-- The persuasive heart of the page. Each row is a real moment in a
       vibe coder's week where Midsphere quietly does its job. Features
       told as scenes, not bullet points. The icon next to each moment
       maps to the matching capability. The dashed vertical rail is the
       "calendar" metaphor. -->
  <section id="week" class="section">
    <div class="container-x">
      <!-- Anchor doodle: a sketched calendar week. Six day-cells, the
           middle one lime — "today" — wherever the reader stands. -->
      <div class="mx-auto mb-6 flex justify-center" aria-hidden="true">
        <svg viewBox="0 0 240 60" width="220" height="56" fill="none" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6" y="14" width="32" height="36" rx="2"/>
          <rect x="44" y="14" width="32" height="36" rx="2"/>
          <rect x="82" y="14" width="32" height="36" rx="2" fill="#D7F25C"/>
          <rect x="82" y="14" width="32" height="36" rx="2"/>
          <rect x="120" y="14" width="32" height="36" rx="2"/>
          <rect x="158" y="14" width="32" height="36" rx="2"/>
          <rect x="196" y="14" width="32" height="36" rx="2"/>
          <path d="M14 22 L 28 22 M 52 22 L 66 22 M 90 22 L 104 22 M 128 22 L 142 22 M 166 22 L 180 22 M 204 22 L 218 22" stroke-width="1.2" style="opacity: 0.5;"/>
          <path d="M14 36 L 24 36 M 14 42 L 22 42 M 52 36 L 64 36 M 90 36 L 100 36 M 90 42 L 102 42 M 128 36 L 138 36 M 166 36 L 176 36 M 166 42 L 172 42 M 204 36 L 214 36" stroke-width="1.2"/>
        </svg>
      </div>

      <div class="mx-auto max-w-[760px] text-center">
        <div class="eyebrow">while you're not looking</div>
        <h2 id="week-headline" class="h-section mx-auto mt-3 max-w-[680px]">
          The week you <span class="hl">stop noticing us</span>.
        </h2>
        <p class="mx-auto mt-4 max-w-[600px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
          You ship the prototype Friday. Then Midsphere keeps running. These are the moments you didn't have to handle, told from a real week.
        </p>
      </div>

      <ol class="relative mx-auto mt-12 max-w-[800px] flex flex-col gap-7">
        <span aria-hidden="true" class="hidden sm:block" style="position: absolute; left: 119px; top: 8px; bottom: 8px; width: 1px; border-left: 1px dashed var(--ms-border-default);"></span>

        {weekMoments.map((m) => (
          <li class="relative grid grid-cols-[80px_28px_1fr] items-start gap-4 sm:grid-cols-[96px_28px_1fr] sm:gap-5">
            <span class="font-mono text-[12px]" style="color: var(--ms-fg-3); letter-spacing: 0.06em; padding-top: 4px;">{m.time}</span>
            <span aria-hidden="true" style="display: inline-flex; align-items: center; justify-content: center; padding-top: 1px; background: var(--ms-bg-canvas); position: relative; z-index: 1;">
              {m.kind === 'persistence' && (
                <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 2 L 13 2 L 16 5 L 16 16 L 2 16 L 2 3 Z"/>
                  <path d="M5 10 L 13 10 L 13 16 L 5 16 Z"/>
                  <path d="M6 4 L 11 4"/>
                </svg>
              )}
              {m.kind === 'approval' && (
                <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 1 L 12 1 L 17 6 L 17 12 L 12 17 L 6 17 L 1 12 L 1 6 Z" fill="#D7F25C"/>
                  <path d="M6 1 L 12 1 L 17 6 L 17 12 L 12 17 L 6 17 L 1 12 L 1 6 Z"/>
                  <path d="M5 9 L 13 9"/>
                </svg>
              )}
              {m.kind === 'schedules' && (
                <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="10" r="6"/>
                  <path d="M9 6 L 9 10 L 12 12"/>
                  <path d="M5 2 L 7 4 M 13 2 L 11 4"/>
                </svg>
              )}
              {m.kind === 'fallback' && (
                <svg width="22" height="18" viewBox="0 0 20 16" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 5 L 16 5"/>
                  <path d="M14 2 L 18 5 L 14 8"/>
                  <path d="M18 11 L 4 11"/>
                  <path d="M6 8 L 2 11 L 6 14"/>
                </svg>
              )}
              {m.kind === 'credits' && (
                <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="9" r="7" fill="#D7F25C"/>
                  <circle cx="9" cy="9" r="7"/>
                  <path d="M9 4 L 9 14"/>
                  <path d="M6 6 C 6 5, 9 4, 11 6 C 11 8, 7 8, 6 9 C 6 11, 9 12, 12 11"/>
                </svg>
              )}
              {m.kind === 'retries' && (
                <svg width="20" height="20" viewBox="0 0 18 18" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 5 C 11 1, 4 2, 3 8 C 2 14, 9 16, 14 12"/>
                  <path d="M14 5 L 10 5 M 14 5 L 14 9"/>
                </svg>
              )}
              {m.kind === 'cost' && (
                <svg width="18" height="22" viewBox="0 0 16 20" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 1 L 14 1 L 14 17 L 11 16 L 8 18 L 5 16 L 2 17 Z"/>
                  <path d="M5 6 L 11 6 M 5 10 L 11 10"/>
                </svg>
              )}
              {m.kind === 'streaming' && (
                <svg width="22" height="14" viewBox="0 0 22 14" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 7 C 4 3, 6 11, 8 7 C 10 3, 12 11, 14 7"/>
                  <path d="M16 4 L 20 7 L 16 10"/>
                </svg>
              )}
            </span>
            <p class="text-fg-1" style="font-size: 16px; line-height: 1.6;">{m.text}</p>
          </li>
        ))}
      </ol>

      <p class="mx-auto mt-12 max-w-[640px] text-center font-medium text-fg-1" style="font-size: 18px; line-height: 1.5; text-wrap: pretty;">
        You spend the time on the part of the product that's <span class="hl-soft">yours</span>.
      </p>
    </div>
  </section>

  <!-- ──────────────────────────────────────── DROP INTO EXISTING APP -->
  <section id="dropin" class="section border-t border-border-subtle">
    <div class="container-x">
      <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-[minmax(0,420px)_1fr] md:gap-14">
        <div>
          <!-- Plug-into-socket doodle. Wall socket on the right (your app),
               plug on the left, cord curving in, lime spark where they
               meet. Says: just plug it in. -->
          <div class="mb-5" aria-hidden="true">
            <svg viewBox="0 0 220 110" width="200" height="100" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <!-- socket on right (existing app surface) -->
              <rect x="142" y="30" width="60" height="56" rx="6" fill="#FFFFFF"/>
              <rect x="142" y="30" width="60" height="56" rx="6"/>
              <!-- two socket holes -->
              <circle cx="160" cy="52" r="3"/>
              <circle cx="184" cy="52" r="3"/>
              <path d="M168 70 L 176 70"/>
              <!-- plug body -->
              <rect x="86" y="44" width="42" height="28" rx="4" fill="#FFFFFF"/>
              <rect x="86" y="44" width="42" height="28" rx="4"/>
              <!-- plug prongs -->
              <path d="M128 52 L 138 52 M 128 64 L 138 64"/>
              <!-- cord -->
              <path d="M86 58 C 60 58, 50 76, 22 78"/>
              <!-- lime spark where prongs meet socket -->
              <path d="M138 44 L 146 36 M 138 64 L 146 72 M 144 52 L 154 50 M 144 64 L 154 66" stroke="#D7F25C" stroke-width="2"/>
              <path d="M138 44 L 146 36 M 138 64 L 146 72 M 144 52 L 154 50 M 144 64 L 154 66" stroke-width="1.4"/>
            </svg>
          </div>

          <div class="eyebrow">already shipped something?</div>
          <h2 id="dropin-headline" class="h-section mt-3 max-w-[420px]">
            Drop the SDK <span class="hl-soft">into the app you have</span>.
          </h2>
          <p class="mt-5 max-w-[480px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
            Add a route handler. Pass your existing Supabase session. Your routes, your components, your types stay exactly as you left them. Mount the agent at <code class="font-mono text-[13px]" style="background: var(--ms-bg-sunken); padding: 2px 6px; border-radius: 4px;">/research</code>, in a sidebar drawer, behind a Slack webhook, anywhere a request can land.
          </p>
        </div>

        <div>
          <div class="font-mono text-[12px] uppercase mb-2" style="color: var(--ms-fg-3); letter-spacing: 0.08em;">
            app/api/agent/route.ts
          </div>
          <CodeBlock code={dropInCode} />
          <p class="mt-4 text-center font-mono" style="font-size: 11px; color: var(--ms-fg-3); letter-spacing: 0.06em;">
            three lines · whatever you've already built
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ────────────────────────────────────────────────── COST FOOTNOTE -->
  <section id="cost" class="section-tight">
    <div class="container-x">
      <div class="mx-auto max-w-[680px] text-center">
        <!-- Coin stack doodle: lime "free" coin sitting in front of two
             smaller coins. Visualizes "free credits up front, pay only
             when you use it." -->
        <div class="mx-auto mb-4 flex justify-center" aria-hidden="true">
          <svg viewBox="0 0 100 60" width="84" height="50" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <!-- back coin -->
            <circle cx="68" cy="36" r="14" fill="#FFFFFF"/>
            <circle cx="68" cy="36" r="14"/>
            <path d="M68 30 L 68 42 M 64 32 C 64 30, 70 30, 72 32 C 72 34, 65 34, 64 36 C 64 38, 70 38, 72 38" stroke-width="1.4"/>
            <!-- front coin, lime -->
            <circle cx="38" cy="34" r="18" fill="#D7F25C"/>
            <circle cx="38" cy="34" r="18"/>
            <path d="M38 24 L 38 44"/>
            <path d="M32 27 C 32 25, 39 23, 43 26 C 43 30, 33 30, 32 33 C 32 36, 40 36, 44 35"/>
            <!-- "free" tag, hand-tied -->
            <path d="M14 12 L 24 18" stroke-dasharray="2 2" stroke-width="1.2"/>
          </svg>
        </div>

        <div class="eyebrow">cost</div>
        <p class="mt-4 font-medium text-fg-1" style="font-size: clamp(20px, 2.2vw, 26px); line-height: 1.35; letter-spacing: -0.015em;">
          Free credits to ship the first one. <span class="hl">Pay only when your users use it.</span>
        </p>
        <p class="mt-3 text-fg-2" style="font-size: 15px; line-height: 1.55;">
          No card up front. No per-seat. Caps you set, the agent stops at.
          <a
            href="/pricing"
            class="ml-2"
            style="color: var(--ms-fg-1); text-decoration: underline; text-decoration-color: var(--ms-accent); text-decoration-thickness: 2px; text-underline-offset: 4px;"
          >see full pricing</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────────────────── OWNERSHIP -->
  <!-- Addresses the lock-in fear directly. Vibe coders distrust SaaS that
       holds their code hostage; this section names every layer they keep
       if they ever leave. Doodle: an open door, someone walking through
       carrying their box of code. -->
  <section id="ownership" class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-[minmax(0,420px)_1fr] md:gap-14">
        <div>
          <div class="mb-5" aria-hidden="true">
            <svg viewBox="0 0 220 130" width="200" height="118" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <!-- door frame -->
              <rect x="40" y="14" width="80" height="100" rx="2"/>
              <!-- door, swung open -->
              <path d="M40 14 L 14 24 L 14 116 L 40 114"/>
              <!-- door knob -->
              <circle cx="22" cy="68" r="2" fill="#111"/>
              <!-- floor line -->
              <path d="M4 116 L 216 116" stroke-dasharray="2 4" stroke-width="1.2" style="opacity: 0.5;"/>
              <!-- person walking through, carrying a box -->
              <circle cx="148" cy="44" r="9"/>
              <path d="M148 53 L 144 88"/>
              <path d="M144 88 L 134 114 M 144 88 L 156 114"/>
              <!-- arms holding box -->
              <path d="M142 64 L 158 70"/>
              <path d="M154 64 L 170 70"/>
              <!-- box -->
              <rect x="158" y="62" width="32" height="22" rx="1" fill="#FFFFFF"/>
              <rect x="158" y="62" width="32" height="22" rx="1"/>
              <path d="M166 70 L 184 70 M 166 76 L 180 76" stroke-width="1.3"/>
              <!-- lime "yours" tag on the box -->
              <rect x="172" y="56" width="22" height="10" rx="2" fill="#D7F25C"/>
              <rect x="172" y="56" width="22" height="10" rx="2"/>
              <!-- motion lines -->
              <path d="M124 90 L 134 90 M 124 100 L 136 100" stroke-dasharray="2 3" stroke-width="1.2" style="opacity: 0.5;"/>
            </svg>
          </div>

          <div class="eyebrow">ownership</div>
          <h2 id="ownership-headline" class="h-section mt-3 max-w-[460px]">
            <span class="hl-soft">You can leave.</span> Nothing's held hostage.
          </h2>
          <p class="mt-5 max-w-[480px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
            @midsphere/sdk is MIT-licensed, on GitHub. @midsphere/ui copies source into your repo, like shadcn. Tools are plain TypeScript functions. Prompts are strings in your code.
          </p>
          <p class="mt-4 max-w-[480px] text-fg-2" style="font-size: 17px; line-height: 1.6;">
            If you rip Midsphere out, you keep your prompts, your tools, your components, and your types. The runtime is one fetch call you can rewrite in an afternoon.
          </p>
        </div>

        <ul class="rounded-[14px] border border-border-subtle bg-canvas p-6 sm:p-7">
          <li class="text-[12px] font-mono uppercase" style="color: var(--ms-fg-3); letter-spacing: 0.08em;">what stays in your repo</li>
          {[
            { label: 'prompts', detail: 'strings in your code, not in our database' },
            { label: 'tools', detail: 'plain TypeScript, run wherever you want' },
            { label: 'components', detail: 'copied source, no version pin' },
            { label: 'types', detail: 'inferred from your tools, owned by you' },
            { label: 'auth', detail: 'your Supabase, your sessions' },
            { label: 'data', detail: 'in your Postgres, behind your RLS' },
          ].map((item) => (
            <li class="mt-3.5 flex items-baseline gap-3">
              <svg width="14" height="11" viewBox="0 0 16 12" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; transform: translateY(2px);">
                <path d="M2 7 L 6 11 L 14 1"/>
              </svg>
              <span class="text-fg-1" style="font-size: 14px; line-height: 1.5;">
                <span class="font-mono text-[13px]" style="background: var(--ms-bg-sunken); padding: 2px 6px; border-radius: 4px;">{item.label}</span>
                <span class="ml-2 text-fg-2">{item.detail}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ────────────────────────────────────────────── P.S. PYTHON ASIDE -->
  <!-- Detached aside for the Pythonistas. Sits as a margin note rather than
       a page-equal beat: sunken card, slight rotate, smaller width. The
       jab lives in the heading; the code carries the actual reassurance. -->
  <section id="python" class="section-tight">
    <div class="container-x">
      <div
        class="relative mx-auto rounded-[16px] bg-sunken"
        style="max-width: 720px; padding: 36px 40px 40px; transform: rotate(-0.4deg); box-shadow: 0 1px 0 rgba(0,0,0,0.04), 0 8px 24px -16px rgba(0,0,0,0.10);"
      >
        <!-- Snake doodle, parked top-right of the card. Small, friendly,
             with a lime tongue tip so it carries the brand without
             screaming. The whole drawing is one continuous S-curve. -->
        <div class="absolute" aria-hidden="true" style="top: 18px; right: 24px;">
          <svg viewBox="0 0 96 56" width="76" height="44" fill="none" stroke="#111" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <!-- coiled body -->
            <path d="M8 44 C 14 28, 28 26, 32 38 C 36 50, 54 50, 60 36 C 64 26, 76 22, 84 28"/>
            <!-- head -->
            <path d="M84 28 C 88 30, 90 34, 88 38"/>
            <!-- tongue, lime fork -->
            <path d="M88 38 L 94 44" stroke="#D7F25C" stroke-width="2"/>
            <path d="M88 38 L 94 44" stroke-width="1.4"/>
            <path d="M94 44 L 92 50 M 94 44 L 96 50" stroke="#D7F25C" stroke-width="2"/>
            <path d="M94 44 L 92 50 M 94 44 L 96 50" stroke-width="1.4"/>
            <!-- eye -->
            <circle cx="86" cy="32" r="0.9" fill="#111"/>
          </svg>
        </div>

        <div class="eyebrow">p.s.</div>
        <h2
          id="python-headline"
          class="mt-3 font-medium text-fg-1"
          style="font-size: clamp(24px, 2.6vw, 30px); line-height: 1.2; letter-spacing: -0.02em; max-width: 520px;"
        >
          Python folks, <span class="hl-soft">we remember you too</span>.
        </h2>
        <p class="mt-4 text-fg-2" style="font-size: 16px; line-height: 1.6; max-width: 520px;">
          Same SDK, different import. FastAPI, Django, Flask, the notebook you keep open. Three lines. No shade.
        </p>

        <div class="mt-6">
          <div class="font-mono text-[12px] uppercase mb-2" style="color: var(--ms-fg-3); letter-spacing: 0.08em;">
            agent.py
          </div>
          <CodeBlock code={pythonCode} />
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────────────────────────────── CLOSING CTA -->
  <section id="ship" class="section">
    <div class="container-x">
      <div class="rounded-[28px] bg-inverse px-12 py-[72px] text-center text-on-inverse-1">
        <div class="mx-auto mb-4 flex justify-center">
          <LightningDoodle variant="on-dark" width={120} />
        </div>
        <div class="eyebrow-on-dark">ship</div>
        <h2
          id="vc-ship-headline"
          class="h-display-lg mx-auto mt-4 mb-5 max-w-[820px] text-on-inverse-1"
        >
          Coffee's not even ready. <span class="hl text-on-inverse-1">Go ahead.</span>
        </h2>
        <p class="mx-auto mb-8 max-w-[540px] text-[16px] leading-[1.55]" style="color: var(--ms-fg-on-inverse-2);">
          One command for a fresh app. Three lines for the one you've got. The first build is on us.
        </p>
        <div class="flex flex-wrap justify-center gap-2.5">
          <Button href="https://platform.midsphere.ai" variant="accent">Start building</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

